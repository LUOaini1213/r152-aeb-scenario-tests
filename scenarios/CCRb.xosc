<?xml version="1.0" encoding="UTF-8"?>
<!--
  CCRb - Car-to-Car Rear braking: VUT (Ego) and target travel at the same speed with a 1.0 s time headway,
  then the target brakes to standstill; 100 % overlap (Euro NCAP impact location 50 %).

  Source of the test definition (see report.md section 2 for quotes):
    - Euro NCAP Crash Avoidance Frontal Collisions Protocol v1.2 (July 2026), 3.1.1.1 CCRb grid:
      VUT speed = GVT speed 30-130 km/h, "Time Headway = 1.0 s, and the target acceleration = -4m/s2";
      "The desired deceleration of the GVT shall be reached within 1.0 second (T0 + 2.0s)";
      1.5.1: for braking scenarios T0 = T_target_deceleration_start - 1 s.
    - UN R152 has no braking-target test; CCRb is evaluated against Euro NCAP only.
  Project choices: the deceleration is applied as a step (reached immediately - the most demanding profile
  that still satisfies "within 1.0 s"); 2 s pre-roll before T0 (deceleration starts at DecelStartTime = 3.0 s);
  vehicle bounding boxes, road geometry, SimEndTime.

  All speeds in m/s, distances in m, TargetDecel is a positive magnitude in m/s2.
  The grid of concrete values lives in CCRb_grid.xosc (generated by scripts/make_scenarios.py).
  ExtCtrl: see CCRs.xosc.
  RoadMu: tyre-road friction coefficient of the run (default 0.9 = the PBC of the R152 / Euro NCAP test
  surface).  Written into the OpenSCENARIO RoadCondition as frictionScaleFactor = RoadMu / 0.9; esmini has
  no tyre model for these entities, so the Python Ego plant applies it: achievable deceleration
  = min(9.0, 10 * RoadMu) m/s2 (anchored to R152 2.13/2.14: PBC 0.9 <-> at least 9 m/s2) - see report.md 9.
-->
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="2" date="2026-10-27T00:00:00" description="CCRb braking target, parameterised" author="Luo Wenjie (AI-assisted)"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="EgoSpeed" parameterType="double" value="13.888889"/>
    <ParameterDeclaration name="TargetSpeed" parameterType="double" value="13.888889"/>
    <ParameterDeclaration name="EgoStartS" parameterType="double" value="50.0"/>
    <ParameterDeclaration name="TargetStartS" parameterType="double" value="68.288889"/>
    <ParameterDeclaration name="TargetDecel" parameterType="double" value="4.0"/>
    <ParameterDeclaration name="DecelStartTime" parameterType="double" value="3.0"/>
    <ParameterDeclaration name="SimEndTime" parameterType="double" value="20.0"/>
    <ParameterDeclaration name="ExtCtrl" parameterType="boolean" value="false"/>
    <ParameterDeclaration name="CaseId" parameterType="string" value="default"/>
    <ParameterDeclaration name="RoadMu" parameterType="double" value="0.9"/>
  </ParameterDeclarations>
  <CatalogLocations/>
  <RoadNetwork>
    <LogicFile filepath="straight_road.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="VUT" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="70.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
        <BoundingBox>
          <Center x="1.4" y="0.0" z="0.75"/>
          <Dimensions width="1.85" length="4.6" height="1.5"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.65" trackWidth="1.6" positionX="2.8" positionZ="0.325"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.65" trackWidth="1.6" positionX="0.0" positionZ="0.325"/>
        </Axles>
        <Properties/>
      </Vehicle>
      <ObjectController>
        <Controller name="AEB_ExternalController">
          <Properties>
            <Property name="esminiController" value="ExternalController"/>
          </Properties>
        </Controller>
      </ObjectController>
    </ScenarioObject>
    <ScenarioObject name="Target">
      <Vehicle name="GVT" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="70.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
        <BoundingBox>
          <Center x="1.3" y="0.0" z="0.75"/>
          <Dimensions width="1.8" length="4.0" height="1.4"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.5" positionX="2.6" positionZ="0.3"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.5" positionX="0.0" positionZ="0.3"/>
        </Axles>
        <Properties/>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <GlobalAction>
          <EnvironmentAction>
            <Environment name="RoadSurface">
              <RoadCondition frictionScaleFactor="${$RoadMu / 0.9}"/>
            </Environment>
          </EnvironmentAction>
        </GlobalAction>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" offset="0.0" s="$EgoStartS"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$EgoSpeed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <PrivateAction>
            <ControllerAction>
              <ActivateControllerAction longitudinal="$ExtCtrl" lateral="$ExtCtrl"/>
            </ControllerAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Target">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" offset="0.0" s="$TargetStartS"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$TargetSpeed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="CCRb">
      <Act name="TargetBraking">
        <ManeuverGroup name="TargetManeuverGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Target"/>
          </Actors>
          <Maneuver name="TargetBrakeManeuver">
            <Event name="TargetBrakeEvent" priority="override" maximumExecutionCount="1">
              <Action name="TargetBrakeToStandstill">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="$TargetDecel" dynamicsDimension="rate"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="0.0"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="DecelStart" delay="0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="$DecelStartTime" rule="greaterOrEqual"/>
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="EndTime" delay="0" conditionEdge="none">
          <ByValueCondition>
            <SimulationTimeCondition value="$SimEndTime" rule="greaterThan"/>
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>
