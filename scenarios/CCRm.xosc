<?xml version="1.0" encoding="UTF-8"?>
<!--
  CCRm - Car-to-Car Rear moving: the VUT (Ego) approaches a target vehicle travelling at constant speed in the same lane,
  100 % overlap (Euro NCAP impact location 50 % = target reference point on the VUT centreline).

  Sources of the test definition (see report.md section 2 for quotes):
    - Euro NCAP Crash Avoidance Frontal Collisions Protocol v1.2 (July 2026), 3.1.1.1 CCRm grid, 1.5.1 T0 = TTC 4 s
    - UN R152 (EUR-Lex 2024/2497, up to Suppl. 3 to the 02 series) 6.5: target at 20 km/h, TTC >= 4 s at start
  Project choices (not from either document): 2 s pre-roll before T0 (simulation starts at TTC = 6 s),
  vehicle bounding boxes, road geometry, SimEndTime.

  All speeds in m/s, distances in m.  The grid of concrete values lives in CCRm_grid.xosc
  (ParameterValueDistribution, generated by scripts/make_scenarios.py).

  ExtCtrl = false: esmini drives the Ego at constant EgoSpeed (open loop, no AEB) - used for the
  standalone sanity run with esmini.exe.  ExtCtrl = true: the Ego is handed to an ExternalController and
  its longitudinal state is reported every step by the Python AEB closed loop (aebtest/esmini_bridge.py).
  RoadMu: tyre-road friction coefficient of the run (default 0.9 = the PBC of the R152 / Euro NCAP test
  surface).  Written into the OpenSCENARIO RoadCondition as frictionScaleFactor = RoadMu / 0.9; esmini has
  no tyre model for these entities, so the Python Ego plant applies it: achievable deceleration
  = min(9.0, 10 * RoadMu) m/s2 (anchored to R152 2.13/2.14: PBC 0.9 <-> at least 9 m/s2) - see report.md 9.
-->
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="2" date="2026-10-27T00:00:00" description="CCRm moving target, parameterised" author="Luo Wenjie (AI-assisted)"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="EgoSpeed" parameterType="double" value="13.888889"/>
    <ParameterDeclaration name="TargetSpeed" parameterType="double" value="5.555556"/>
    <ParameterDeclaration name="EgoStartS" parameterType="double" value="50.0"/>
    <ParameterDeclaration name="TargetStartS" parameterType="double" value="104.4"/>
    <ParameterDeclaration name="SimEndTime" parameterType="double" value="20.0"/>
    <ParameterDeclaration name="ExtCtrl" parameterType="boolean" value="false"/>
    <ParameterDeclaration name="CaseId" parameterType="string" value="default"/>
    <ParameterDeclaration name="RoadMu" parameterType="double" value="0.9"/>
  </ParameterDeclarations>
  <CatalogLocations/>
  <RoadNetwork>
    <LogicFile filepath="straight_road.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="VUT" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="70.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
        <BoundingBox>
          <Center x="1.4" y="0.0" z="0.75"/>
          <Dimensions width="1.85" length="4.6" height="1.5"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.65" trackWidth="1.6" positionX="2.8" positionZ="0.325"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.65" trackWidth="1.6" positionX="0.0" positionZ="0.325"/>
        </Axles>
        <Properties/>
      </Vehicle>
      <ObjectController>
        <Controller name="AEB_ExternalController">
          <Properties>
            <Property name="esminiController" value="ExternalController"/>
          </Properties>
        </Controller>
      </ObjectController>
    </ScenarioObject>
    <ScenarioObject name="Target">
      <Vehicle name="GVT" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="70.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
        <BoundingBox>
          <Center x="1.3" y="0.0" z="0.75"/>
          <Dimensions width="1.8" length="4.0" height="1.4"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.5" positionX="2.6" positionZ="0.3"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.5" positionX="0.0" positionZ="0.3"/>
        </Axles>
        <Properties/>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <GlobalAction>
          <EnvironmentAction>
            <Environment name="RoadSurface">
              <RoadCondition frictionScaleFactor="${$RoadMu / 0.9}"/>
            </Environment>
          </EnvironmentAction>
        </GlobalAction>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" offset="0.0" s="$EgoStartS"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$EgoSpeed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <PrivateAction>
            <ControllerAction>
              <ActivateControllerAction longitudinal="$ExtCtrl" lateral="$ExtCtrl"/>
            </ControllerAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Target">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" offset="0.0" s="$TargetStartS"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$TargetSpeed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="EndTime" delay="0" conditionEdge="none">
          <ByValueCondition>
            <SimulationTimeCondition value="$SimEndTime" rule="greaterThan"/>
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>
