<?xml version="1.0" encoding="UTF-8"?>
<!--
  Straight, flat 2 km road for the longitudinal AEB test scenarios (CCRs / CCRm / CCRb).
  One 3.5 m driving lane per direction; the vehicles use lane -1 (travel in +s direction).
  Lane width, length and markings are project choices; neither R152 nor Euro NCAP prescribes them
  (R152 6.1.1: flat dry surface, slope 0-1 %; Euro NCAP CA Frontal Collisions v1.2 2.1: slope <= 1 %).
-->
<OpenDRIVE>
  <header revMajor="1" revMinor="5" name="straight_2km" version="1.0" date="2026-10-27T00:00:00" north="0.0" south="0.0" east="2000.0" west="0.0"/>
  <road name="straight" length="2000.0" id="1" junction="-1">
    <link/>
    <type s="0.0" type="rural"/>
    <planView>
      <geometry s="0.0" x="0.0" y="0.0" hdg="0.0" length="2000.0">
        <line/>
      </geometry>
    </planView>
    <elevationProfile>
      <elevation s="0.0" a="0.0" b="0.0" c="0.0" d="0.0"/>
    </elevationProfile>
    <lateralProfile/>
    <lanes>
      <laneSection s="0.0">
        <left>
          <lane id="1" type="driving" level="false">
            <link/>
            <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
            <roadMark sOffset="0.0" type="solid" weight="standard" color="standard" width="0.12"/>
          </lane>
        </left>
        <center>
          <lane id="0" type="none" level="false">
            <link/>
            <roadMark sOffset="0.0" type="broken" weight="standard" color="standard" width="0.12"/>
          </lane>
        </center>
        <right>
          <lane id="-1" type="driving" level="false">
            <link/>
            <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
            <roadMark sOffset="0.0" type="solid" weight="standard" color="standard" width="0.12"/>
          </lane>
        </right>
      </laneSection>
    </lanes>
  </road>
</OpenDRIVE>
